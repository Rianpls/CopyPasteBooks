{
    "schemaVersion": 1,
    "id": "copypastebooks",
    "version": "${version}",
    "name": "CopyPasteBooks",
    "description": "Copy books out to text files or the clipboard and paste text into books. Page ranges, volumes for 100+ page texts, formatting-aware copying.",
    "authors": [
        "Rianpls"
    ],
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": [
            "io.github.rianpls.copypastebooks.fabric.CPBFabric"
        ],
        "modmenu": [
            "io.github.rianpls.copypastebooks.fabric.CPBModMenu"
        ]
    },
    "mixins": [
        "copypastebooks.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": ">=26.1 <26.3",
        "java": ">=25",
        "fabric-api": "*"
    },
    "suggests": {
        "modmenu": "*"
    }
}
